// ─────────────────────────────────────────────────────────────────
// SCHEMA PRISMA — Delfina Paz CRM
// Sprint: Dashboards + Ventas + PDF + Configuración
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// USUARIOS DEL SISTEMA
// ─────────────────────────────────────────────────────────────────
model Usuario {
  id         String     @id @default(cuid())
  email      String     @unique
  nombre     String
  apellido   String?
  password   String
  rol        RolUsuario @default(EMPLEADA)
  activo     Boolean    @default(true)
  color      String     @default("#C8A882")
  tipo_comision        TipoComision @default(NINGUNA)
  porcentaje_comision  Decimal      @default(0) @db.Decimal(5, 2)

  // Permisos configurables por usuario
  puede_ver_caja                Boolean @default(false)
  puede_cobrar                  Boolean @default(false)
  puede_anular_ventas           Boolean @default(false)
  puede_reimprimir_comprobantes Boolean @default(false)
  puede_ver_ventas_dia          Boolean @default(false)
  puede_ver_reportes            Boolean @default(false)
  puede_gestionar_turnos        Boolean @default(true)
  puede_gestionar_clientes      Boolean @default(false)
  puede_gestionar_servicios     Boolean @default(false)
  puede_gestionar_productos     Boolean @default(false)
  puede_gestionar_configuracion Boolean @default(false)
  puede_gestionar_usuarios      Boolean @default(false)
  puede_gestionar_integraciones Boolean @default(false)

  telefono   String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  turnos      Turno[]              @relation("TurnosProfesional")
  ventas_prof Venta[]              @relation("VentasProfesional")
  eventos     EventoN8n[]
  horarios    HorarioProfesional[] // NUEVO

  @@map("usuarios")
}

enum RolUsuario {
  OWNER
  ADMIN
  EMPLEADA
}

enum TipoComision {
  SERVICIOS   // comisión sobre items tipo SERVICIO
  PRODUCTOS   // comisión sobre items tipo PRODUCTO
  NINGUNA
}

// ─────────────────────────────────────────────────────────────────
// HORARIOS POR PROFESIONAL — NUEVO
// Una profesional puede tener múltiples bloques por día
// (ej: 09:00-13:00 y 15:00-19:00 con pausa de almuerzo)
// ─────────────────────────────────────────────────────────────────
model HorarioProfesional {
  id             String   @id @default(cuid())
  profesional_id String
  dia_semana     Int      // 0=Domingo, 1=Lunes, ..., 6=Sábado
  hora_inicio    String   // formato "HH:mm" — ej "09:00"
  hora_fin       String   // formato "HH:mm" — ej "19:00"
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profesional Usuario @relation(fields: [profesional_id], references: [id], onDelete: Cascade)

  @@unique([profesional_id, dia_semana, hora_inicio])
  @@index([profesional_id])
  @@map("horarios_profesionales")
}

// ─────────────────────────────────────────────────────────────────
// CLIENTES
// ─────────────────────────────────────────────────────────────────
model Cliente {
  id               String        @id @default(cuid())
  nombre           String
  apellido         String?
  dni              String?       @unique
  telefono         String?       @unique
  email            String?       @unique
  segmento         Segmento      @default(FINAL)
  origen           OrigenCliente @default(MANUAL)
  instagram_id     String?
  tiendanube_id    String?
  notas            String?
  total_compras    Decimal       @default(0) @db.Decimal(12, 2)
  cant_turnos      Int           @default(0)
  ultimo_turno     DateTime?
  ultima_compra    DateTime?
  fecha_nacimiento DateTime?
  activo           Boolean       @default(true)
  deletedAt        DateTime?     // soft-delete
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  turnos    Turno[]
  ventas    Venta[]
  consultas Consulta[]
  mensajes  MensajeWA[]

  @@index([telefono])
  @@index([segmento])
  @@index([origen])
  @@index([deletedAt])
  @@map("clientes")
}

enum Segmento {
  FINAL
  MAYORISTA
  VIP
}

enum OrigenCliente {
  MANUAL
  WHATSAPP
  INSTAGRAM_DM
  INSTAGRAM_COMENTARIO
  TIENDANUBE
  BOCA_A_BOCA
  LINK_PUBLICO  // NUEVO — clienta que llegó por la página pública de reservas
}

// ─────────────────────────────────────────────────────────────────
// SERVICIOS
// ─────────────────────────────────────────────────────────────────
model Servicio {
  id           String            @id @default(cuid())
  nombre       String
  descripcion  String?
  categoria    CategoriaServicio
  duracion_min Int
  precio       Decimal           @db.Decimal(10, 2)
  foto_url     String?
  activo       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // NUEVO — configuración de seña
  sena_tipo       TipoSena @default(SIN_SENA)
  sena_porcentaje Decimal? @db.Decimal(5, 2)   // Ej: 30.00 = 30%
  sena_monto_fijo Decimal? @db.Decimal(10, 2)  // Ej: 5000.00 = $5.000

  // buffer de limpieza después del turno
  buffer_min Int @default(5)

  deletedAt DateTime? // soft-delete

  turnos  Turno[]
  insumos InsumoServicio[]

  @@index([deletedAt])
  @@map("servicios")
}

enum CategoriaServicio {
  MANOS_PIES
  CEJAS_PESTANAS
  LABIOS
  FACIAL
  OTRO
}

// NUEVO
enum TipoSena {
  SIN_SENA
  PORCENTAJE
  MONTO_FIJO
}

// ─────────────────────────────────────────────────────────────────
// PRODUCTOS / STOCK
// ─────────────────────────────────────────────────────────────────
model Producto {
  id                 String            @id @default(cuid())
  nombre             String
  sku                String?           @unique
  categoria          CategoriaProducto
  precio_minorista   Decimal           @db.Decimal(10, 2)
  precio_mayorista   Decimal?          @db.Decimal(10, 2)
  stock_actual       Int               @default(0)
  stock_minimo       Int               @default(5)
  foto_url           String?
  tiendanube_prod_id String?
  tiendanube_var_id  String?
  costo              Decimal?  @db.Decimal(10, 2) // para margen estimado
  activo             Boolean   @default(true)
  deletedAt          DateTime? // soft-delete
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  movimientos MovimientoStock[]
  insumos     InsumoServicio[]

  @@index([categoria])
  @@index([stock_actual])
  @@index([deletedAt])
  @@map("productos")
}

enum CategoriaProducto {
  INSUMO
  MARCA_PROPIA
  REVENTA
}

// ─────────────────────────────────────────────────────────────────
// INSUMOS POR SERVICIO
// ─────────────────────────────────────────────────────────────────
model InsumoServicio {
  id          String @id @default(cuid())
  servicio_id String
  producto_id String
  cantidad    Int    @default(1)

  servicio Servicio @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  producto Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([servicio_id, producto_id])
  @@map("insumos_servicios")
}

// ─────────────────────────────────────────────────────────────────
// MOVIMIENTOS DE STOCK
// ─────────────────────────────────────────────────────────────────
model MovimientoStock {
  id               String         @id @default(cuid())
  producto_id      String
  tipo             TipoMovimiento
  cantidad         Int
  stock_resultante Int
  referencia_id    String?
  notas            String?
  createdAt        DateTime       @default(now())

  producto Producto @relation(fields: [producto_id], references: [id])

  @@index([producto_id])
  @@index([tipo])
  @@map("movimientos_stock")
}

enum TipoMovimiento {
  VENTA_LOCAL
  VENTA_ONLINE
  USO_SERVICIO
  AJUSTE_MANUAL
  ENTRADA
}

// ─────────────────────────────────────────────────────────────────
// TURNOS
// ─────────────────────────────────────────────────────────────────
model Turno {
  id                   String      @id @default(cuid())
  cliente_id           String
  servicio_id          String
  profesional_id       String
  fecha                DateTime
  duracion_min         Int
  precio               Decimal     @db.Decimal(10, 2)
  estado               EstadoTurno @default(PENDIENTE)
  sena                 Decimal?    @db.Decimal(10, 2)
  notas                String?
  observaciones        String?     // NUEVO — comentarios internos del admin
  confirmacion_enviada Boolean     @default(false)
  recordatorio_enviado Boolean     @default(false)
  seguimiento_enviado  Boolean     @default(false)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  // NUEVO — montos de la reserva
  monto_total    Decimal  @db.Decimal(10, 2)
  monto_sena     Decimal? @db.Decimal(10, 2)
  sena_requerida Boolean  @default(false)

  // NUEVO — flujo de reserva
  reserva_expira_en DateTime?
  origen_reserva    OrigenReserva @default(ADMIN)

  // NUEVO — Mercado Pago (último intento, denormalizado)
  mp_preference_id      String?
  mp_init_point         String?
  mp_external_reference String?

  cliente     Cliente  @relation(fields: [cliente_id], references: [id])
  servicio    Servicio @relation(fields: [servicio_id], references: [id])
  profesional Usuario  @relation("TurnosProfesional", fields: [profesional_id], references: [id])

  // NUEVO — agrupa turnos consecutivos del mismo booking multi-servicio
  grupo_reserva_id String?

  // NUEVAS relaciones
  pagos_sena   PagoSena[]
  comprobantes ComprobanteManual[]

  @@index([fecha])
  @@index([estado])
  @@index([cliente_id])
  @@index([profesional_id])
  @@index([reserva_expira_en])         // NUEVO — para el cron de vencimiento
  @@index([mp_external_reference])     // NUEVO — para resolver webhooks rápido
  @@index([grupo_reserva_id])          // NUEVO — para confirmar grupo de turnos
  @@map("turnos")
}

enum EstadoTurno {
  PENDIENTE                       // existente
  PENDIENTE_PAGO_MP               // NUEVO
  PENDIENTE_VALIDACION_MANUAL     // NUEVO (fase 2)
  CONFIRMADO                      // existente
  EN_CURSO                        // existente
  PENDIENTE_FACTURAR              // NUEVO — servicio terminado, esperando cobro en caja
  COMPLETADO                      // existente
  CANCELADO                       // existente
  NO_SHOW                         // existente
  VENCIDO                         // NUEVO
  RECHAZADO                       // NUEVO
}

// NUEVO
enum OrigenReserva {
  ADMIN
  LINK_PUBLICO
  WHATSAPP
  INSTAGRAM
  TIENDANUBE
}

// ─────────────────────────────────────────────────────────────────
// PAGOS DE SEÑA — NUEVO
// Cada intento de pago genera un registro nuevo
// ─────────────────────────────────────────────────────────────────
model PagoSena {
  id                   String         @id @default(cuid())
  turno_id             String
  provider             String         @default("MERCADOPAGO")
  external_reference   String         @unique
  preference_id        String?
  payment_id           String?        @unique  // CLAVE — idempotencia del webhook
  merchant_order_id    String?
  status               EstadoPagoSena @default(CREADO)
  status_detail        String?
  amount               Decimal        @db.Decimal(10, 2)
  currency             String         @default("ARS")
  init_point           String?
  payer_email          String?
  payer_id             String?
  webhook_payload      Json?
  raw_payment_response Json?
  approved_at          DateTime?
  rejected_at          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  turno Turno @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@index([turno_id])
  @@index([status])
  @@map("pagos_sena")
}

enum EstadoPagoSena {
  CREADO
  PENDIENTE
  APROBADO
  RECHAZADO
  VENCIDO
  REEMBOLSADO
  VALIDACION_MANUAL
}

// ─────────────────────────────────────────────────────────────────
// COMPROBANTES MANUALES — NUEVO (fase 2)
// Schema preparado, lógica completa en MVP 2
// ─────────────────────────────────────────────────────────────────
model ComprobanteManual {
  id                      String            @id @default(cuid())
  turno_id                String
  archivo_url             String
  monto_detectado         Decimal?          @db.Decimal(10, 2)
  fecha_detectada         DateTime?
  alias_detectado         String?
  num_operacion_detectado String?
  confianza_validacion    Decimal?          @db.Decimal(3, 2)
  estado                  EstadoComprobante @default(PENDIENTE)
  motivo_revision         String?
  validado_por_usuario_id String?
  validado_at             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  turno Turno @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@index([turno_id])
  @@index([estado])
  @@map("comprobantes_manuales")
}

enum EstadoComprobante {
  PENDIENTE
  APROBADO
  RECHAZADO
  REQUIERE_REVISION
}

// ─────────────────────────────────────────────────────────────────
// CONSULTAS / LEADS
// ─────────────────────────────────────────────────────────────────
model Consulta {
  id         String         @id @default(cuid())
  cliente_id String?
  canal      CanalConsulta
  mensaje    String
  estado     EstadoConsulta @default(NUEVA)
  notas      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  cliente Cliente? @relation(fields: [cliente_id], references: [id])

  @@index([estado])
  @@index([canal])
  @@map("consultas")
}

enum CanalConsulta {
  WHATSAPP
  INSTAGRAM
  TIENDANUBE
  WEB
  PRESENCIAL
}

enum EstadoConsulta {
  NUEVA
  EN_PROCESO
  RESUELTA
  ARCHIVADA
}

// ─────────────────────────────────────────────────────────────────
// INTEGRACIONES EXTERNAS
// ─────────────────────────────────────────────────────────────────
model Integracion {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activa    Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integraciones")
}

// ─────────────────────────────────────────────────────────────────
// LOG DE EVENTOS N8N (extendido como log de automatizaciones)
// ─────────────────────────────────────────────────────────────────
model EventoN8n {
  id            String       @id @default(cuid())
  workflow_name String
  workflow_id   String?
  estado        EstadoEvento
  mensaje       String
  referencia_id String?
  usuario_id    String?
  payload       Json?        // NUEVO
  error         String?      // NUEVO
  createdAt     DateTime     @default(now())

  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([estado])
  @@index([createdAt])
  @@index([workflow_name])  // NUEVO — para queries por workflow
  @@map("eventos_n8n")
}

enum EstadoEvento {
  EXITOSO
  ERROR
  PENDIENTE
}

// ─────────────────────────────────────────────────────────────────
// VENTAS / POS
// ─────────────────────────────────────────────────────────────────
model Venta {
  id                  String      @id @default(cuid())
  numero_comprobante  Int?        @unique // número interno secuencial — único entre no-nulos
  cliente_id          String?
  profesional_id      String?
  turno_id            String?
  estado              EstadoVenta @default(PAGADA)
  origen              OrigenVenta @default(LOCAL)
  medio_pago          MedioPago
  subtotal            Decimal     @db.Decimal(12, 2)
  descuento           Decimal     @default(0) @db.Decimal(12, 2) // monto de descuento en $
  descuento_pct       Decimal     @default(0) @db.Decimal(5, 2)  // porcentaje de descuento
  total               Decimal     @db.Decimal(12, 2)
  sena_aplicada       Decimal?    @db.Decimal(12, 2) // seña previa descontada
  notas               String?
  motivo_anulacion    String?     // para estado ANULADA
  pdf_url             String?     // URL del comprobante PDF en MinIO
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  cliente     Cliente?    @relation(fields: [cliente_id], references: [id])
  profesional Usuario?    @relation("VentasProfesional", fields: [profesional_id], references: [id])
  items       ItemVenta[]

  @@index([createdAt])
  @@index([cliente_id])
  @@index([estado])
  @@index([origen])
  @@index([profesional_id])
  @@map("ventas")
}

enum EstadoVenta {
  BORRADOR
  PAGADA
  PAGO_PARCIAL
  ANULADA
  DEVUELTA
}

enum OrigenVenta {
  LOCAL
  TURNO
  TIENDANUBE
  WHATSAPP
  LINK_PUBLICO
}

model ItemVenta {
  id              String  @id @default(cuid())
  venta_id        String
  tipo            String  // SERVICIO | PRODUCTO
  referencia_id   String  // id del servicio o producto
  nombre          String
  cantidad        Int     @default(1)
  precio_unitario Decimal @db.Decimal(10, 2)
  descuento       Decimal @default(0) @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(10, 2)

  venta Venta @relation(fields: [venta_id], references: [id], onDelete: Cascade)

  @@map("items_venta")
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  MERCADOPAGO
}

// ─────────────────────────────────────────────────────────────────
// MENSAJES WHATSAPP — historial de envíos
// ─────────────────────────────────────────────────────────────────
model MensajeWA {
  id          String        @id @default(cuid())
  cliente_id  String?
  telefono    String
  tipo        TipoMensajeWA
  estado      EstadoMensajeWA @default(ENVIADO)
  contenido   String
  turno_id    String?
  sid         String?       // Twilio message SID
  error       String?
  createdAt   DateTime      @default(now())

  cliente Cliente? @relation(fields: [cliente_id], references: [id])

  @@index([cliente_id])
  @@index([tipo])
  @@index([createdAt])
  @@map("mensajes_wa")
}

enum TipoMensajeWA {
  CONFIRMACION
  RECORDATORIO
  CUMPLEANOS
  SEGUIMIENTO
  PAGO_APROBADO
  PAGO_RECHAZADO
  VALIDACION_MANUAL
  PRUEBA
}

enum EstadoMensajeWA {
  ENVIADO
  FALLIDO
  PENDIENTE
}

// ─────────────────────────────────────────────────────────────────
// CONFIGURACIÓN DEL NEGOCIO — singleton (upsert por nombre)
// ─────────────────────────────────────────────────────────────────
model ConfiguracionNegocio {
  id               String   @id @default(cuid())
  nombre_comercial String   @default("Delfina Paz Beauty")
  cuit             String?
  direccion        String?
  telefono         String?
  email            String?
  instagram        String?
  logo_url         String?
  color_principal  String   @default("#A68660")
  texto_footer     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("configuracion_negocio")
}

// ─────────────────────────────────────────────────────────────────
// CONFIGURACIÓN DE RESERVAS Y SEÑAS
// ─────────────────────────────────────────────────────────────────
model ConfiguracionReservas {
  id                       String        @id @default(cuid())
  sena_obligatoria         Boolean       @default(false)
  sena_tipo                TipoSena      @default(SIN_SENA)
  sena_porcentaje          Decimal?      @db.Decimal(5, 2)
  sena_monto_fijo          Decimal?      @db.Decimal(10, 2)
  metodo_sena              MetodoSena    @default(SIN_SENA)
  vencimiento_minutos      Int           @default(30)
  vencimiento_transf_horas Int           @default(24)
  mp_link_alternativo      String?
  alias_transferencia      String?
  titular_alias            String?
  mensaje_sena             String?
  mensaje_confirmacion     String?
  mensaje_recordatorio     String?
  tolerancia_validacion    Int           @default(60)
  estado_inicial_mp        EstadoTurno   @default(PENDIENTE_PAGO_MP)
  estado_inicial_transf    EstadoTurno   @default(PENDIENTE_VALIDACION_MANUAL)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  @@map("configuracion_reservas")
}

enum MetodoSena {
  MERCADOPAGO
  TRANSFERENCIA
  AMBOS
  SIN_SENA
}

// ─────────────────────────────────────────────────────────────────
// PLANTILLA DE COMPROBANTE / PDF
// ─────────────────────────────────────────────────────────────────
model PlantillaComprobante {
  id                   String   @id @default(cuid())
  nombre_comercial     String   @default("Delfina Paz Beauty")
  cuit                 String?
  direccion            String?
  telefono             String?
  instagram            String?
  logo_url             String?
  color_principal      String   @default("#A68660")
  texto_footer         String?
  mostrar_logo         Boolean  @default(true)
  mostrar_cuit         Boolean  @default(false)
  mostrar_direccion    Boolean  @default(true)
  mostrar_telefono     Boolean  @default(true)
  mostrar_instagram    Boolean  @default(true)
  mostrar_qr           Boolean  @default(false)
  tipo_documento       String   @default("COMPROBANTE") // COMPROBANTE | RECIBO | FACTURA
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("plantilla_comprobante")
}

// ─────────────────────────────────────────────────────────────────
// NOTIFICACIONES — panel del admin
// ─────────────────────────────────────────────────────────────────
model Notificacion {
  id            String           @id @default(cuid())
  tipo          TipoNotificacion
  titulo        String
  mensaje       String
  referencia_id String?          // id del turno / pago / comprobante referenciado
  url_destino   String?          // ruta a la que lleva el click. Ej: /admin/turnos/tablero
  leida         Boolean          @default(false)
  leida_at      DateTime?
  // Si es null => notificacion global (visible para todos los admins).
  // Si tiene valor => notificacion dirigida a ese usuario.
  usuario_id    String?
  createdAt     DateTime         @default(now())

  @@index([leida, createdAt(sort: Desc)])
  @@index([usuario_id, leida])
  @@map("notificaciones")
}

enum TipoNotificacion {
  TURNO_NUEVO
  TURNO_CONFIRMADO
  TURNO_CANCELADO
  TURNO_VENCIDO
  PAGO_APROBADO
  PAGO_RECHAZADO
  COMPROBANTE_PENDIENTE
  COMPROBANTE_APROBADO
  SISTEMA
}
