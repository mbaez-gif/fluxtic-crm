// ─────────────────────────────────────────────────────────────────
// SCHEMA PRISMA — Fluxtic Salud (CRM Clínico)
// Etapa 1 — Foundation
// ─────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═════════════════════════════════════════════════════════════════
//  ENUMS
// ═════════════════════════════════════════════════════════════════

enum RolUsuario {
  ADMIN_GENERAL
  RECEPCION
  FACTURACION
  MEDICO
  COORDINADOR_MEDICO
  PACIENTE
  AUDITOR
}

enum EstadoTurno {
  PENDIENTE
  PENDIENTE_PAGO_MP
  PENDIENTE_VALIDACION_MANUAL
  CONFIRMADO
  EN_SALA_ESPERA
  EN_ATENCION
  ATENDIDO
  CANCELADO
  AUSENTE
  VENCIDO
}

enum OrigenReserva {
  ADMIN
  PORTAL_PACIENTE
  LINK_PUBLICO
  WHATSAPP
  TELEFONO
  N8N
}

enum MetodoCopago {
  SIN_COPAGO
  MERCADOPAGO
  TRANSFERENCIA
  AMBOS
}

enum EstadoPagoMercadoPago {
  CREADO
  PENDIENTE
  APROBADO
  RECHAZADO
  VENCIDO
  REEMBOLSADO
  VALIDACION_MANUAL
}

enum EstadoComprobanteTransferencia {
  PENDIENTE_REVISION
  APROBADO
  RECHAZADO
}

enum ModalidadTurno {
  PRESENCIAL
  VIRTUAL
}

enum EstadoPaciente {
  ACTIVO
  INACTIVO
  EN_SEGUIMIENTO
  BLOQUEADO
}

enum SegmentoPaciente {
  GENERAL
  VIP
  CRONICO
  SEGUIMIENTO
  PARTICULAR
  COBERTURA
}

enum CanalOrigen {
  RECEPCION
  WHATSAPP
  WEB
  INSTAGRAM
  REFERIDO
  CAMPANIA
  PORTAL_PACIENTE
  OTRO
}

enum SeveridadAlertaClinica {
  INFO
  ADVERTENCIA
  CRITICA
}

enum TipoBloqueoAgenda {
  DIA_COMPLETO
  RANGO_HORARIO
  PROFESIONAL
  SEDE
  CONSULTORIO
}

enum EstadoReceta {
  BORRADOR
  FIRMADA
  ENVIADA
  ANULADA
}

enum TipoOrdenMedica {
  RECETA
  ORDEN_ESTUDIO
  CERTIFICADO
  INDICACION_MEDICA
}

enum EstadoVideoconsulta {
  PENDIENTE
  EN_CURSO
  FINALIZADA
  CANCELADA
}

enum ProveedorVideoconsulta {
  JITSI
  GOOGLE_MEET
  WHEREBY
  ZOOM
  CUSTOM
}

enum Sexo {
  FEMENINO
  MASCULINO
  OTRO
  SIN_DATO
}

enum TipoAntecedente {
  PERSONAL
  FAMILIAR
  QUIRURGICO
  OBSTETRICO
  GINECOLOGICO
  TRAUMATICO
  OTRO
}

enum SeveridadAlergia {
  LEVE
  MODERADA
  SEVERA
  CRITICA
}

enum EstadoAutorizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  EXPIRADA
}

enum TipoDocumentoClinico {
  EVOLUCION
  ESTUDIO
  INFORME
  IMAGEN
  RECETA
  CONSENTIMIENTO
  INDICACION
  OTRO
}

enum AccionAuditoria {
  VER
  CREAR
  MODIFICAR
  ELIMINAR
  EXPORTAR
  FIRMAR
  DESCARGAR
  LOGIN
  LOGOUT
  ACCESO_DENEGADO
}

enum EstadoComprobante {
  BORRADOR
  EMITIDO
  PAGADO
  PAGO_PARCIAL
  ANULADO
}

enum TipoComprobante {
  RECIBO
  FACTURA
  PRESUPUESTO
  NOTA_CREDITO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  DEBITO
  CREDITO
  MERCADOPAGO
  CHEQUE
  COBERTURA
}

enum TipoCobertura {
  PARTICULAR
  OBRA_SOCIAL
  PREPAGA
}

enum CanalComunicacion {
  WHATSAPP
  EMAIL
  SMS
}

enum TipoComunicacion {
  CONFIRMACION_TURNO
  RECORDATORIO_48H
  RECORDATORIO_24H
  RECORDATORIO_2H
  PREPARACION_PREVIA
  POSTCONSULTA
  SEGUIMIENTO
  REACTIVACION
  PAGO_PENDIENTE
  CONFIRMACION_PAGO
  CAMPANIA
  OTRO
}

enum EstadoComunicacion {
  PENDIENTE
  ENVIADA
  ENTREGADA
  LEIDA
  RESPONDIDA
  FALLIDA
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
  AJUSTE
  USO_PRESTACION
  VENCIMIENTO
}

enum TipoNotificacion {
  TURNO_PROXIMO
  TURNO_CANCELADO
  PACIENTE_EN_SALA
  PAGO_RECIBIDO
  COMPROBANTE_PENDIENTE
  STOCK_CRITICO
  VENCIMIENTO_INSUMO
  AUTORIZACION_PENDIENTE
  OTRO
}

// ═════════════════════════════════════════════════════════════════
//  USUARIOS Y PERFILES
// ═════════════════════════════════════════════════════════════════

model Usuario {
  id             String     @id @default(cuid())
  email          String     @unique
  password       String
  nombre         String
  apellido       String?
  telefono       String?
  rol            RolUsuario
  activo         Boolean    @default(true)
  es_profesional Boolean    @default(false)
  es_paciente    Boolean    @default(false)
  ultimo_login   DateTime?
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt

  perfil_profesional PerfilProfesional?
  paciente           Paciente?
  turnos_creados     Turno[]            @relation("TurnosCreador")
  evoluciones        EvolucionClinica[]
  indicaciones       Indicacion[]
  consentimientos    Consentimiento[]   @relation("ConsentimientoCreador")
  documentos         DocumentoClinico[] @relation("DocumentoSubidoPor")
  movimientos_caja   MovimientoCaja[]
  comprobantes       Comprobante[]      @relation("ComprobanteCreador")
  pagos_registrados  Pago[]             @relation("PagoRegistradoPor")
  audit_logs         AuditLog[]
  notificaciones     Notificacion[]
}

model PerfilProfesional {
  id                     String   @id @default(cuid())
  usuario_id             String   @unique
  matricula              String   @unique
  matricula_jurisdiccion String?
  especialidad_id        String
  subespecialidad        String?
  duracion_consulta_min  Int      @default(30)
  porcentaje_liquidacion Decimal? @db.Decimal(5, 2)
  color_agenda           String?  @default("#0F766E")
  bio                    String?
  firma_url              String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  usuario      Usuario      @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  especialidad Especialidad @relation(fields: [especialidad_id], references: [id])

  sedes                ProfesionalSede[]
  horarios             HorarioProfesional[]
  prestaciones         ProfesionalPrestacion[]
  turnos               Turno[]                 @relation("TurnosProfesional")
  evoluciones_firmadas EvolucionClinica[]      @relation("EvolucionProfesional")
  liquidaciones        Liquidacion[]
  bloqueos             BloqueoAgenda[]
  recetas              Receta[]                @relation("RecetasProfesional")

  @@index([especialidad_id])
}

// ═════════════════════════════════════════════════════════════════
//  ORGANIZACIÓN (sedes, consultorios, especialidades)
// ═════════════════════════════════════════════════════════════════

model Sede {
  id         String   @id @default(cuid())
  nombre     String
  direccion  String?
  ciudad     String?
  provincia  String?
  telefono   String?
  email      String?
  activa     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  consultorios  Consultorio[]
  profesionales ProfesionalSede[]
  turnos        Turno[]
  bloqueos      BloqueoAgenda[]
}

model Consultorio {
  id          String   @id @default(cuid())
  sede_id     String
  nombre      String
  numero      String?
  descripcion String?
  activo      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  sede     Sede            @relation(fields: [sede_id], references: [id], onDelete: Restrict)
  turnos   Turno[]
  bloqueos BloqueoAgenda[]

  @@unique([sede_id, nombre])
  @@index([sede_id])
}

model Especialidad {
  id          String   @id @default(cuid())
  nombre      String   @unique
  codigo      String?  @unique
  descripcion String?
  activa      Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  profesionales PerfilProfesional[]
  prestaciones  Prestacion[]
}

model ProfesionalSede {
  profesional_id String
  sede_id        String
  asignado_at    DateTime @default(now())

  profesional PerfilProfesional @relation(fields: [profesional_id], references: [id], onDelete: Cascade)
  sede        Sede              @relation(fields: [sede_id], references: [id], onDelete: Cascade)

  @@id([profesional_id, sede_id])
}

model HorarioProfesional {
  id             String   @id @default(cuid())
  profesional_id String
  sede_id        String?
  dia_semana     Int // 0=domingo, 1=lunes, ..., 6=sábado
  hora_inicio    String // "08:00"
  hora_fin       String // "12:00"
  activo         Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  profesional PerfilProfesional @relation(fields: [profesional_id], references: [id], onDelete: Cascade)

  @@index([profesional_id, dia_semana])
}

// ═════════════════════════════════════════════════════════════════
//  PACIENTES
// ═════════════════════════════════════════════════════════════════

model Paciente {
  id                 String           @id @default(cuid())
  usuario_id         String?          @unique
  dni                String           @unique
  nombre             String
  apellido           String
  fecha_nacimiento   DateTime?
  sexo               Sexo             @default(SIN_DATO)
  telefono           String?
  email              String?
  direccion          String?
  ciudad             String?
  provincia          String?
  ocupacion          String?
  observaciones      String?
  estado             EstadoPaciente   @default(ACTIVO)
  segmento           SegmentoPaciente @default(GENERAL)
  canal_origen       CanalOrigen      @default(RECEPCION)
  referido_por       String?
  campania_origen    String?
  ultima_atencion_at DateTime?
  total_turnos       Int              @default(0)
  total_gastado      Decimal          @default(0) @db.Decimal(12, 2)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  usuario          Usuario?               @relation(fields: [usuario_id], references: [id], onDelete: SetNull)
  historia_clinica HistoriaClinica?
  contactos        ContactoEmergencia[]
  coberturas       PacienteCobertura[]
  turnos           Turno[]
  comprobantes     Comprobante[]
  pagos            Pago[]
  deudas           Deuda[]
  comunicaciones   ComunicacionPaciente[]
  consentimientos  Consentimiento[]
  documentos       DocumentoClinico[]
  estudios         Estudio[]
  alertas_clinicas AlertaClinica[]
  recetas          Receta[]
  encuestas        EncuestaSatisfaccion[]

  @@index([apellido, nombre])
  @@index([deleted_at])
  @@index([segmento])
  @@index([canal_origen])
}

model ContactoEmergencia {
  id          String   @id @default(cuid())
  paciente_id String
  nombre      String
  vinculo     String?
  telefono    String
  email       String?
  prioritario Boolean  @default(false)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  paciente Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  @@index([paciente_id])
}

// ═════════════════════════════════════════════════════════════════
//  COBERTURAS MÉDICAS
// ═════════════════════════════════════════════════════════════════

model CoberturaMedica {
  id            String        @id @default(cuid())
  nombre        String        @unique
  tipo          TipoCobertura
  codigo        String?
  cuit          String?
  telefono      String?
  email         String?
  observaciones String?
  activa        Boolean       @default(true)
  created_at    DateTime      @default(now())
  updated_at    DateTime      @updatedAt

  planes         PlanCobertura[]
  afiliaciones   PacienteCobertura[]
  autorizaciones Autorizacion[]
}

model PlanCobertura {
  id                   String   @id @default(cuid())
  cobertura_id         String
  nombre               String
  codigo               String?
  porcentaje_cobertura Decimal? @db.Decimal(5, 2)
  observaciones        String?
  activo               Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  cobertura    CoberturaMedica     @relation(fields: [cobertura_id], references: [id], onDelete: Cascade)
  afiliaciones PacienteCobertura[]

  @@unique([cobertura_id, nombre])
  @@index([cobertura_id])
}

model PacienteCobertura {
  id              String    @id @default(cuid())
  paciente_id     String
  cobertura_id    String
  plan_id         String?
  numero_afiliado String
  vigencia_desde  DateTime?
  vigencia_hasta  DateTime?
  principal       Boolean   @default(true)
  activa          Boolean   @default(true)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  paciente  Paciente        @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  cobertura CoberturaMedica @relation(fields: [cobertura_id], references: [id], onDelete: Restrict)
  plan      PlanCobertura?  @relation(fields: [plan_id], references: [id])

  @@index([paciente_id])
  @@index([cobertura_id])
}

model Autorizacion {
  id               String             @id @default(cuid())
  paciente_id      String
  cobertura_id     String
  prestacion_id    String?
  numero           String?
  estado           EstadoAutorizacion @default(PENDIENTE)
  monto_autorizado Decimal?           @db.Decimal(12, 2)
  vigencia_desde   DateTime?
  vigencia_hasta   DateTime?
  observaciones    String?
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt

  cobertura  CoberturaMedica @relation(fields: [cobertura_id], references: [id])
  prestacion Prestacion?     @relation(fields: [prestacion_id], references: [id])

  @@index([paciente_id])
  @@index([estado])
}

// ═════════════════════════════════════════════════════════════════
//  PRESTACIONES (servicios médicos)
// ═════════════════════════════════════════════════════════════════

model Prestacion {
  id                        String   @id @default(cuid())
  codigo                    String?  @unique
  nombre                    String
  descripcion               String?
  especialidad_id           String?
  duracion_min              Int      @default(30)
  precio_particular         Decimal  @default(0) @db.Decimal(12, 2)
  requiere_autorizacion     Boolean  @default(false)
  requiere_consentimiento   Boolean  @default(false)
  requiere_preparacion      Boolean  @default(false)
  permite_telemedicina      Boolean  @default(false)
  instrucciones_preparacion String?
  activa                    Boolean  @default(true)
  created_at                DateTime @default(now())
  updated_at                DateTime @updatedAt

  especialidad   Especialidad?           @relation(fields: [especialidad_id], references: [id])
  profesionales  ProfesionalPrestacion[]
  turnos         Turno[]
  items_comprob  ItemComprobante[]
  insumos        InsumoPrestacion[]
  autorizaciones Autorizacion[]

  @@index([especialidad_id])
}

model ProfesionalPrestacion {
  profesional_id String
  prestacion_id  String
  precio_propio  Decimal? @db.Decimal(12, 2)
  asignado_at    DateTime @default(now())

  profesional PerfilProfesional @relation(fields: [profesional_id], references: [id], onDelete: Cascade)
  prestacion  Prestacion        @relation(fields: [prestacion_id], references: [id], onDelete: Cascade)

  @@id([profesional_id, prestacion_id])
}

// ═════════════════════════════════════════════════════════════════
//  AGENDA / TURNOS
// ═════════════════════════════════════════════════════════════════

model Turno {
  id                       String         @id @default(cuid())
  paciente_id              String
  profesional_id           String
  prestacion_id            String?
  sede_id                  String
  consultorio_id           String?
  fecha_hora               DateTime
  duracion_min             Int            @default(30)
  modalidad                ModalidadTurno @default(PRESENCIAL)
  estado                   EstadoTurno    @default(PENDIENTE)
  sobreturno               Boolean        @default(false)
  lista_espera             Boolean        @default(false)
  motivo_consulta          String?
  observaciones            String?
  creado_por_id            String?
  cancelado_at             DateTime?
  cancelado_motivo         String?
  ingreso_sala_at          DateTime?
  inicio_atencion_at       DateTime?
  fin_atencion_at          DateTime?
  recordatorio_48h_enviado Boolean        @default(false)
  recordatorio_24h_enviado Boolean        @default(false)
  recordatorio_2h_enviado  Boolean        @default(false)

  // Mensajería contextual del turno
  mensaje_interno        String? // visible solo al equipo (recepción/profesional)
  mensaje_paciente       String? // visible al paciente (en portal y comunicaciones)
  computa_disponibilidad Boolean @default(true)

  // Telemedicina
  videoconsulta_proveedor ProveedorVideoconsulta?
  videoconsulta_url       String?
  videoconsulta_room      String?
  videoconsulta_estado    EstadoVideoconsulta?
  videoconsulta_inicio_at DateTime?
  videoconsulta_fin_at    DateTime?

  // Copago / seña previa (heredado del flujo Delfina, adaptado a clínica)
  requiere_copago       Boolean       @default(false)
  monto_total           Decimal?      @db.Decimal(12, 2)
  monto_copago          Decimal?      @db.Decimal(12, 2)
  metodo_copago         MetodoCopago  @default(SIN_COPAGO)
  reserva_expira_en     DateTime?
  origen_reserva        OrigenReserva @default(ADMIN)
  // Mercado Pago (último intento, denormalizado para resolver webhooks rápido)
  mp_preference_id      String?
  mp_init_point         String?
  mp_external_reference String?
  // Agrupación de turnos consecutivos en una misma reserva
  grupo_reserva_id      String?

  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  paciente    Paciente          @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  profesional PerfilProfesional @relation("TurnosProfesional", fields: [profesional_id], references: [id], onDelete: Restrict)
  prestacion  Prestacion?       @relation(fields: [prestacion_id], references: [id])
  sede        Sede              @relation(fields: [sede_id], references: [id], onDelete: Restrict)
  consultorio Consultorio?      @relation(fields: [consultorio_id], references: [id])
  creado_por  Usuario?          @relation("TurnosCreador", fields: [creado_por_id], references: [id])

  evolucion                  EvolucionClinica?
  comprobantes               Comprobante[]
  comunicaciones             ComunicacionPaciente[]
  cambios_estado             CambioEstadoTurno[]
  pagos_mp                   PagoMercadoPago[]
  comprobantes_transferencia ComprobanteTransferencia[]
  recetas                    Receta[]

  @@index([paciente_id])
  @@index([profesional_id, fecha_hora])
  @@index([sede_id, fecha_hora])
  @@index([estado])
  @@index([deleted_at])
  @@index([reserva_expira_en])
  @@index([mp_external_reference])
  @@index([grupo_reserva_id])
}

model CambioEstadoTurno {
  id              String       @id @default(cuid())
  turno_id        String
  estado_anterior EstadoTurno?
  estado_nuevo    EstadoTurno
  usuario_id      String?
  motivo          String?
  created_at      DateTime     @default(now())

  turno Turno @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@index([turno_id])
}

// ═════════════════════════════════════════════════════════════════
//  HISTORIA CLÍNICA
// ═════════════════════════════════════════════════════════════════

model HistoriaClinica {
  id                      String   @id @default(cuid())
  paciente_id             String   @unique
  numero                  String?  @unique
  grupo_sanguineo         String?
  factor_rh               String?
  observaciones_generales String?
  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt

  paciente Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  evoluciones  EvolucionClinica[]
  antecedentes Antecedente[]
  alergias     Alergia[]
  medicaciones MedicacionHabitual[]
  diagnosticos Diagnostico[]
  indicaciones Indicacion[]
}

model EvolucionClinica {
  id                 String    @id @default(cuid())
  historia_id        String
  turno_id           String?   @unique
  profesional_id     String
  usuario_id         String // quién la cargó (puede ser admin/médico)
  fecha              DateTime  @default(now())
  motivo_consulta    String?
  subjetivo          String? // S
  objetivo           String? // O
  analisis           String? // A
  plan               String? // P
  texto_libre        String?
  firmado_at         DateTime?
  firmado_por_id     String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  historia     HistoriaClinica   @relation(fields: [historia_id], references: [id], onDelete: Restrict)
  turno        Turno?            @relation(fields: [turno_id], references: [id])
  profesional  PerfilProfesional @relation("EvolucionProfesional", fields: [profesional_id], references: [id])
  usuario      Usuario           @relation(fields: [usuario_id], references: [id])
  diagnosticos Diagnostico[]
  indicaciones Indicacion[]
  recetas      Receta[]

  @@index([historia_id, fecha])
  @@index([deleted_at])
}

model Antecedente {
  id                 String          @id @default(cuid())
  historia_id        String
  tipo               TipoAntecedente
  descripcion        String
  fecha              DateTime?
  cie10              String?
  activo             Boolean         @default(true)
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  historia HistoriaClinica @relation(fields: [historia_id], references: [id], onDelete: Cascade)

  @@index([historia_id, tipo])
  @@index([deleted_at])
}

model Alergia {
  id                 String           @id @default(cuid())
  historia_id        String
  sustancia          String
  severidad          SeveridadAlergia @default(LEVE)
  reaccion           String?
  fecha_inicio       DateTime?
  activa             Boolean          @default(true)
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  historia HistoriaClinica @relation(fields: [historia_id], references: [id], onDelete: Cascade)

  @@index([historia_id])
  @@index([deleted_at])
}

model MedicacionHabitual {
  id                 String    @id @default(cuid())
  historia_id        String
  medicamento        String
  dosis              String?
  frecuencia         String?
  via                String?
  desde              DateTime?
  hasta              DateTime?
  motivo             String?
  activa             Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  historia HistoriaClinica @relation(fields: [historia_id], references: [id], onDelete: Cascade)

  @@index([historia_id])
  @@index([deleted_at])
}

model Diagnostico {
  id                 String    @id @default(cuid())
  historia_id        String
  evolucion_id       String?
  cie10              String?
  descripcion        String
  fecha              DateTime  @default(now())
  activo             Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  historia  HistoriaClinica   @relation(fields: [historia_id], references: [id], onDelete: Cascade)
  evolucion EvolucionClinica? @relation(fields: [evolucion_id], references: [id])

  @@index([historia_id])
  @@index([cie10])
  @@index([deleted_at])
}

model Indicacion {
  id                 String    @id @default(cuid())
  historia_id        String
  evolucion_id       String?
  usuario_id         String
  texto              String
  fecha              DateTime  @default(now())
  visible_paciente   Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  historia  HistoriaClinica   @relation(fields: [historia_id], references: [id], onDelete: Cascade)
  evolucion EvolucionClinica? @relation(fields: [evolucion_id], references: [id])
  usuario   Usuario           @relation(fields: [usuario_id], references: [id])

  @@index([historia_id])
  @@index([deleted_at])
}

model Estudio {
  id                 String    @id @default(cuid())
  paciente_id        String
  tipo               String
  descripcion        String?
  fecha_solicitud    DateTime?
  fecha_resultado    DateTime?
  resultado_texto    String?
  documento_id       String?   @unique
  solicitado_por_id  String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  paciente  Paciente          @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  documento DocumentoClinico? @relation(fields: [documento_id], references: [id])

  @@index([paciente_id])
  @@index([deleted_at])
}

model DocumentoClinico {
  id                 String               @id @default(cuid())
  paciente_id        String
  tipo               TipoDocumentoClinico
  nombre             String
  storage_key        String
  url_publica        String?
  mime_type          String?
  tamano_bytes       Int?
  subido_por_id      String?
  visible_paciente   Boolean              @default(false)
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  paciente   Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  subido_por Usuario? @relation("DocumentoSubidoPor", fields: [subido_por_id], references: [id])
  estudio    Estudio?

  @@index([paciente_id, tipo])
  @@index([deleted_at])
}

model Consentimiento {
  id                 String    @id @default(cuid())
  paciente_id        String
  tipo               String // ej. "Consentimiento informado para cirugía"
  texto              String
  firmado            Boolean   @default(false)
  firmado_at         DateTime?
  documento_url      String?
  creado_por_id      String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  paciente   Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  creado_por Usuario? @relation("ConsentimientoCreador", fields: [creado_por_id], references: [id])

  @@index([paciente_id])
  @@index([deleted_at])
}

// ═════════════════════════════════════════════════════════════════
//  FACTURACIÓN Y COBROS
// ═════════════════════════════════════════════════════════════════

model Comprobante {
  id                 String            @id @default(cuid())
  numero             String?           @unique
  tipo               TipoComprobante   @default(RECIBO)
  paciente_id        String
  turno_id           String?
  fecha              DateTime          @default(now())
  subtotal           Decimal           @default(0) @db.Decimal(12, 2)
  descuento          Decimal           @default(0) @db.Decimal(12, 2)
  total              Decimal           @default(0) @db.Decimal(12, 2)
  total_pagado       Decimal           @default(0) @db.Decimal(12, 2)
  saldo              Decimal           @default(0) @db.Decimal(12, 2)
  estado             EstadoComprobante @default(BORRADOR)
  observaciones      String?
  creado_por_id      String?
  anulado_at         DateTime?
  anulado_motivo     String?
  created_at         DateTime          @default(now())
  updated_at         DateTime          @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  paciente   Paciente          @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  turno      Turno?            @relation(fields: [turno_id], references: [id])
  creado_por Usuario?          @relation("ComprobanteCreador", fields: [creado_por_id], references: [id])
  items      ItemComprobante[]
  pagos      Pago[]
  deuda      Deuda?

  @@index([paciente_id])
  @@index([fecha])
  @@index([estado])
  @@index([deleted_at])
}

model ItemComprobante {
  id              String   @id @default(cuid())
  comprobante_id  String
  prestacion_id   String?
  descripcion     String
  cantidad        Int      @default(1)
  precio_unitario Decimal  @db.Decimal(12, 2)
  subtotal        Decimal  @db.Decimal(12, 2)
  created_at      DateTime @default(now())

  comprobante Comprobante @relation(fields: [comprobante_id], references: [id], onDelete: Cascade)
  prestacion  Prestacion? @relation(fields: [prestacion_id], references: [id])

  @@index([comprobante_id])
}

model Pago {
  id                 String    @id @default(cuid())
  comprobante_id     String?
  paciente_id        String
  monto              Decimal   @db.Decimal(12, 2)
  medio              MedioPago
  referencia_externa String?
  cobertura_id       String?
  registrado_por_id  String?
  fecha              DateTime  @default(now())
  observaciones      String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  comprobante     Comprobante?    @relation(fields: [comprobante_id], references: [id])
  paciente        Paciente        @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  registrado_por  Usuario?        @relation("PagoRegistradoPor", fields: [registrado_por_id], references: [id])
  movimiento_caja MovimientoCaja?

  @@index([paciente_id])
  @@index([fecha])
  @@index([deleted_at])
}

model MovimientoCaja {
  id            String    @id @default(cuid())
  pago_id       String?   @unique
  usuario_id    String
  fecha         DateTime  @default(now())
  tipo          String // INGRESO | EGRESO | AJUSTE
  monto         Decimal   @db.Decimal(12, 2)
  medio         MedioPago
  concepto      String
  observaciones String?
  created_at    DateTime  @default(now())

  pago    Pago?   @relation(fields: [pago_id], references: [id])
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@index([fecha])
}

model Deuda {
  id             String   @id @default(cuid())
  paciente_id    String
  comprobante_id String?  @unique
  monto_original Decimal  @db.Decimal(12, 2)
  saldo_actual   Decimal  @db.Decimal(12, 2)
  fecha_origen   DateTime @default(now())
  observaciones  String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  paciente    Paciente     @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  comprobante Comprobante? @relation(fields: [comprobante_id], references: [id])

  @@index([paciente_id])
}

model Liquidacion {
  id             String    @id @default(cuid())
  profesional_id String
  periodo_inicio DateTime
  periodo_fin    DateTime
  total          Decimal   @db.Decimal(12, 2)
  observaciones  String?
  pagada_at      DateTime?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  profesional PerfilProfesional @relation(fields: [profesional_id], references: [id], onDelete: Restrict)
  items       LiquidacionItem[]

  @@index([profesional_id])
}

model LiquidacionItem {
  id             String  @id @default(cuid())
  liquidacion_id String
  descripcion    String
  monto          Decimal @db.Decimal(12, 2)
  comprobante_id String?

  liquidacion Liquidacion @relation(fields: [liquidacion_id], references: [id], onDelete: Cascade)

  @@index([liquidacion_id])
}

// ═════════════════════════════════════════════════════════════════
//  INSUMOS Y STOCK
// ═════════════════════════════════════════════════════════════════

model Insumo {
  id                 String    @id @default(cuid())
  codigo             String?   @unique
  nombre             String
  descripcion        String?
  unidad             String    @default("unidad")
  stock_actual       Int       @default(0)
  stock_minimo       Int       @default(0)
  proveedor          String?
  precio_unitario    Decimal?  @db.Decimal(12, 2)
  activo             Boolean   @default(true)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  movimientos  MovimientoStock[]
  prestaciones InsumoPrestacion[]
  lotes        LoteInsumo[]

  @@index([deleted_at])
}

model LoteInsumo {
  id          String    @id @default(cuid())
  insumo_id   String
  numero_lote String
  vencimiento DateTime?
  cantidad    Int       @default(0)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  insumo Insumo @relation(fields: [insumo_id], references: [id], onDelete: Cascade)

  @@unique([insumo_id, numero_lote])
  @@index([vencimiento])
}

model MovimientoStock {
  id            String              @id @default(cuid())
  insumo_id     String
  lote_id       String?
  tipo          TipoMovimientoStock
  cantidad      Int
  observaciones String?
  usuario_id    String?
  prestacion_id String?
  turno_id      String?
  created_at    DateTime            @default(now())

  insumo Insumo @relation(fields: [insumo_id], references: [id], onDelete: Restrict)

  @@index([insumo_id, created_at])
}

model InsumoPrestacion {
  insumo_id     String
  prestacion_id String
  cantidad      Int    @default(1)

  insumo     Insumo     @relation(fields: [insumo_id], references: [id], onDelete: Cascade)
  prestacion Prestacion @relation(fields: [prestacion_id], references: [id], onDelete: Cascade)

  @@id([insumo_id, prestacion_id])
}

// ═════════════════════════════════════════════════════════════════
//  COMUNICACIONES Y PLANTILLAS
// ═════════════════════════════════════════════════════════════════

model PlantillaMensaje {
  id         String            @id @default(cuid())
  codigo     String            @unique
  canal      CanalComunicacion
  tipo       TipoComunicacion
  asunto     String?
  cuerpo     String
  variables  String? // JSON con variables disponibles
  activa     Boolean           @default(true)
  created_at DateTime          @default(now())
  updated_at DateTime          @updatedAt
}

model ComunicacionPaciente {
  id            String             @id @default(cuid())
  paciente_id   String
  turno_id      String?
  canal         CanalComunicacion
  tipo          TipoComunicacion
  destino       String
  asunto        String?
  cuerpo        String
  estado        EstadoComunicacion @default(PENDIENTE)
  enviada_at    DateTime?
  entregada_at  DateTime?
  leida_at      DateTime?
  respondida_at DateTime?
  error_mensaje String?
  external_id   String?
  metadata      String? // JSON con detalles del proveedor
  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  paciente Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)
  turno    Turno?   @relation(fields: [turno_id], references: [id])

  @@index([paciente_id])
  @@index([turno_id])
  @@index([estado])
}

// ═════════════════════════════════════════════════════════════════
//  AUTOMATIZACIONES Y AUDITORÍA
// ═════════════════════════════════════════════════════════════════

model AutomatizacionLog {
  id            String   @id @default(cuid())
  evento        String
  workflow_id   String?
  payload       String // JSON
  estado        String // OK | ERROR | SKIPPED
  error_mensaje String?
  duracion_ms   Int?
  created_at    DateTime @default(now())

  @@index([evento])
  @@index([created_at])
}

model AuditLog {
  id          String          @id @default(cuid())
  usuario_id  String?
  accion      AccionAuditoria
  entidad     String // "Paciente", "HistoriaClinica", "EvolucionClinica", etc.
  entidad_id  String?
  descripcion String?
  diff        String? // JSON con cambios
  ip          String?
  user_agent  String?
  contexto    String? // JSON con contexto adicional (ej. paciente_id si la entidad no lo es)
  created_at  DateTime        @default(now())

  usuario Usuario? @relation(fields: [usuario_id], references: [id])

  @@index([entidad, entidad_id])
  @@index([usuario_id, created_at])
  @@index([accion, created_at])
}

// ═════════════════════════════════════════════════════════════════
//  CONFIGURACIÓN
// ═════════════════════════════════════════════════════════════════

model ConfiguracionClinica {
  id              String   @id @default("singleton")
  nombre          String   @default("Fluxtic Salud")
  razon_social    String?
  cuit            String?
  telefono        String?
  email           String?
  sitio_web       String?
  logo_url        String?
  color_principal String   @default("#0F766E")
  color_acento    String   @default("#2563EB")
  zona_horaria    String   @default("America/Argentina/Buenos_Aires")
  moneda          String   @default("ARS")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

model ConfiguracionAgenda {
  id                         String   @id @default("singleton")
  duracion_slot_min          Int      @default(30)
  permite_sobreturnos        Boolean  @default(true)
  permite_lista_espera       Boolean  @default(true)
  anticipacion_min_horas     Int      @default(2)
  cancelacion_min_horas      Int      @default(24)
  recordatorio_48h           Boolean  @default(true)
  recordatorio_24h           Boolean  @default(true)
  recordatorio_2h            Boolean  @default(false)
  marcar_no_show_min_minutos Int      @default(15)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt
}

model ConfiguracionFacturacion {
  id                   String   @id @default("singleton")
  requiere_sena        Boolean  @default(false)
  monto_sena_default   Decimal? @db.Decimal(12, 2)
  porcentaje_sena      Decimal? @db.Decimal(5, 2)
  acepta_mercadopago   Boolean  @default(false)
  acepta_transferencia Boolean  @default(true)
  numerador_recibo     Int      @default(1)
  prefijo_recibo       String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════
//  NOTIFICACIONES IN-APP
// ═════════════════════════════════════════════════════════════════

model Notificacion {
  id         String           @id @default(cuid())
  usuario_id String
  tipo       TipoNotificacion
  titulo     String
  cuerpo     String?
  link       String?
  metadata   String?
  leida_at   DateTime?
  created_at DateTime         @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id, leida_at])
  @@index([created_at])
}

// ═════════════════════════════════════════════════════════════════
//  TOKENS / SESIONES DEL PORTAL DEL PACIENTE
// ═════════════════════════════════════════════════════════════════

model TokenPaciente {
  id          String    @id @default(cuid())
  paciente_id String
  token       String    @unique
  proposito   String // "RESERVA_PUBLICA", "DESCARGA_DOC", etc.
  usado_at    DateTime?
  expira_at   DateTime
  created_at  DateTime  @default(now())

  @@index([paciente_id])
  @@index([token])
}

// ═════════════════════════════════════════════════════════════════
//  MERCADO PAGO — pagos de copago / seña previa
// ═════════════════════════════════════════════════════════════════

model PagoMercadoPago {
  id                   String                @id @default(cuid())
  turno_id             String
  provider             String                @default("MERCADOPAGO")
  external_reference   String                @unique
  preference_id        String?
  payment_id           String?               @unique // idempotencia del webhook
  merchant_order_id    String?
  status               EstadoPagoMercadoPago @default(CREADO)
  status_detail        String?
  amount               Decimal               @db.Decimal(12, 2)
  currency             String                @default("ARS")
  init_point           String?
  payer_email          String?
  payer_id             String?
  webhook_payload      String? // JSON serializado
  raw_payment_response String? // JSON serializado
  approved_at          DateTime?
  rejected_at          DateTime?
  created_at           DateTime              @default(now())
  updated_at           DateTime              @updatedAt

  turno Turno @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@index([turno_id])
  @@index([status])
}

// ═════════════════════════════════════════════════════════════════
//  COMPROBANTES DE TRANSFERENCIA — copago por transferencia bancaria
// ═════════════════════════════════════════════════════════════════

model ComprobanteTransferencia {
  id                     String                         @id @default(cuid())
  turno_id               String
  archivo_url            String
  storage_key            String?
  monto_detectado        Decimal?                       @db.Decimal(12, 2)
  fecha_detectada        DateTime?
  alias_detectado        String?
  observaciones_paciente String?
  estado                 EstadoComprobanteTransferencia @default(PENDIENTE_REVISION)
  revisado_por_id        String?
  revisado_at            DateTime?
  motivo_rechazo         String?
  created_at             DateTime                       @default(now())
  updated_at             DateTime                       @updatedAt

  turno Turno @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@index([turno_id])
  @@index([estado])
}

// ═════════════════════════════════════════════════════════════════
//  BLOQUEOS DE AGENDA
// ═════════════════════════════════════════════════════════════════

model BloqueoAgenda {
  id                String            @id @default(cuid())
  tipo              TipoBloqueoAgenda
  desde             DateTime
  hasta             DateTime
  profesional_id    String?
  sede_id           String?
  consultorio_id    String?
  motivo            String
  cancela_turnos    Boolean           @default(false)
  turnos_cancelados Int               @default(0)
  creado_por_id     String?
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt

  profesional PerfilProfesional? @relation(fields: [profesional_id], references: [id], onDelete: Cascade)
  sede        Sede?              @relation(fields: [sede_id], references: [id], onDelete: Cascade)
  consultorio Consultorio?       @relation(fields: [consultorio_id], references: [id], onDelete: Cascade)

  @@index([desde, hasta])
  @@index([profesional_id])
  @@index([sede_id])
}

// ═════════════════════════════════════════════════════════════════
//  FERIADOS Y CALENDARIO CLÍNICA
// ═════════════════════════════════════════════════════════════════

model FeriadoClinica {
  id            String   @id @default(cuid())
  fecha         DateTime @unique
  nombre        String
  cierra_total  Boolean  @default(true)
  observaciones String?
  created_at    DateTime @default(now())
}

// ═════════════════════════════════════════════════════════════════
//  ALERTAS CLÍNICAS DEL PACIENTE
//  (banner permanente en la ficha — alergias críticas, condiciones especiales)
// ═════════════════════════════════════════════════════════════════

model AlertaClinica {
  id            String                 @id @default(cuid())
  paciente_id   String
  titulo        String
  descripcion   String?
  severidad     SeveridadAlertaClinica @default(INFO)
  activa        Boolean                @default(true)
  creada_por_id String?
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt

  paciente Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  @@index([paciente_id, activa])
}

// ═════════════════════════════════════════════════════════════════
//  RECETAS ELECTRÓNICAS Y ÓRDENES MÉDICAS
// ═════════════════════════════════════════════════════════════════

model Receta {
  id                 String          @id @default(cuid())
  numero             String?         @unique
  tipo               TipoOrdenMedica @default(RECETA)
  paciente_id        String
  profesional_id     String
  evolucion_id       String?
  turno_id           String?
  fecha              DateTime        @default(now())
  estado             EstadoReceta    @default(BORRADOR)
  diagnostico_cie10  String?
  diagnostico_texto  String?
  observaciones      String?
  // Firma electrónica
  firmada_at         DateTime?
  firma_hash         String? // hash SHA-256 del contenido firmado
  // Envío
  enviada_at         DateTime?
  enviada_canal      String? // WHATSAPP / EMAIL
  pdf_url            String?
  // Integración futura con proveedor externo
  proveedor_externo  String?
  external_id        String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  deleted_at         DateTime?
  deleted_by         String?
  motivo_eliminacion String?

  paciente    Paciente          @relation(fields: [paciente_id], references: [id], onDelete: Restrict)
  profesional PerfilProfesional @relation("RecetasProfesional", fields: [profesional_id], references: [id], onDelete: Restrict)
  evolucion   EvolucionClinica? @relation(fields: [evolucion_id], references: [id])
  turno       Turno?            @relation(fields: [turno_id], references: [id])
  items       ItemReceta[]

  @@index([paciente_id])
  @@index([profesional_id])
  @@index([estado])
  @@index([deleted_at])
}

model ItemReceta {
  id             String   @id @default(cuid())
  receta_id      String
  medicamento_id String?
  descripcion    String // nombre del medicamento (denormalizado por si cambia el vademécum)
  presentacion   String? // ej. "20 mg comprimidos"
  cantidad       String? // ej. "30 comprimidos"
  posologia      String? // ej. "1 comprimido cada 8 horas"
  duracion       String? // ej. "7 días"
  via            String? // oral, IM, subcutánea, etc.
  observaciones  String?
  orden          Int      @default(0)
  created_at     DateTime @default(now())

  receta      Receta       @relation(fields: [receta_id], references: [id], onDelete: Cascade)
  medicamento Medicamento? @relation(fields: [medicamento_id], references: [id])

  @@index([receta_id])
}

// ═════════════════════════════════════════════════════════════════
//  VADEMÉCUM LOCAL — caché de medicamentos
//  (futura integración con vademécum externo, ej. Manuel Alfonsín / Kairos)
// ═════════════════════════════════════════════════════════════════

model Medicamento {
  id                     String   @id @default(cuid())
  codigo_externo         String?  @unique // ID del vademécum externo
  nombre_comercial       String
  principio_activo       String
  laboratorio            String?
  presentacion           String? // forma + concentración
  via_admin              String?
  prescripcion_requerida Boolean  @default(true)
  activo                 Boolean  @default(true)
  // Interacciones (lista de principios activos con los que interactúa)
  interacciones          String? // JSON serializado: [{ principio, severidad, descripcion }]
  contraindicaciones     String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  items_receta ItemReceta[]

  @@index([principio_activo])
  @@index([nombre_comercial])
}

// ═════════════════════════════════════════════════════════════════
//  PLANTILLAS DE HISTORIA CLÍNICA POR ESPECIALIDAD
// ═════════════════════════════════════════════════════════════════

model PlantillaHistoriaClinica {
  id              String   @id @default(cuid())
  codigo          String   @unique
  nombre          String
  especialidad_id String?
  estructura      String // JSON con campos del template (label, type, required)
  texto_base      String? // texto pre-cargado
  activa          Boolean  @default(true)
  creada_por_id   String?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt
}

// ═════════════════════════════════════════════════════════════════
//  ENCUESTAS DE SATISFACCIÓN POST-CONSULTA
// ═════════════════════════════════════════════════════════════════

model EncuestaSatisfaccion {
  id             String    @id @default(cuid())
  paciente_id    String
  turno_id       String?   @unique
  profesional_id String?
  enviada_at     DateTime  @default(now())
  respondida_at  DateTime?
  puntaje        Int? // 1-5 o 1-10
  nps_score      Int? // 0-10
  comentario     String?
  recomendaria   Boolean?
  canal_envio    String? // WHATSAPP / EMAIL
  created_at     DateTime  @default(now())

  paciente Paciente @relation(fields: [paciente_id], references: [id], onDelete: Cascade)

  @@index([paciente_id])
  @@index([respondida_at])
}
