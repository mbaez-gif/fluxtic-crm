# ── Base de datos ─────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=delfina_app
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres-delfina:5432/${POSTGRES_DB}

# ── NextAuth ──────────────────────────────────────────────────────
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=https://admin-delfina.fluxtic.com

# URL interna para que Next.js llame a la API dentro de Docker
INTERNAL_API_URL=http://api-delfina:3001

# ── API ───────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=

# ── WhatsApp ──────────────────────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=

# ── Instagram ─────────────────────────────────────────────────────
IG_WEBHOOK_VERIFY_TOKEN=

# ── n8n ───────────────────────────────────────────────────────────
N8N_DB=delfina_n8n
N8N_ENCRYPTION_KEY=
N8N_USER=
N8N_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── MinIO ─────────────────────────────────────────────────────────
MINIO_USER=
MINIO_PASSWORD=
