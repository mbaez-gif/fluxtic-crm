# ── Base de datos ─────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=salud_app
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres-salud:5432/${POSTGRES_DB}

# ── NextAuth ──────────────────────────────────────────────────────
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=https://admin-salud.fluxtic.com

# URL interna para que Next.js llame a la API dentro de Docker
INTERNAL_API_URL=http://api-salud:3001

# ── API ───────────────────────────────────────────────────────────
INTERNAL_API_TOKEN=

# ── Auditoría clínica ─────────────────────────────────────────────
# Controla retención de AuditLog (días). Por defecto retiene indefinido.
AUDIT_LOG_RETENTION_DAYS=

# ── n8n ───────────────────────────────────────────────────────────
N8N_DB=salud_n8n
N8N_ENCRYPTION_KEY=
N8N_USER=
N8N_PASSWORD=
N8N_WEBHOOK_BASE_URL=https://n8n-salud.fluxtic.com

# ── Redis ─────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── MinIO / storage clínico ───────────────────────────────────────
MINIO_USER=
MINIO_PASSWORD=

# ── Comunicaciones con pacientes (opcional, heredado) ─────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_WEBHOOK_VERIFY_TOKEN=

# ── Pagos / copagos (opcional, heredado) ──────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_SUCCESS_URL=
MERCADOPAGO_PENDING_URL=
MERCADOPAGO_FAILURE_URL=

# ── Anti-bot del portal público ───────────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# ── Google (autofill DNI en portal público) ───────────────────────
GOOGLE_CLIENT_ID=
